# General
APP_ENV=dev
LOG_LEVEL=INFO
API_PORT=8000

# Redis (broker + backend)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Celery
WORKER_CONCURRENCY=4
QUEUE_DEFAULT=default
QUEUE_HIGH=high
QUEUE_LOW=low

# Flower
FLOWER_PORT=5555

# Build/Registry (GHCR)
# Replace <owner> (e.g., your GitHub username or org) as needed
GHCR_OWNER=<owner>
IMAGE_BASE=ghcr.io/${GHCR_OWNER}/artifyaiv1
VERSION=0.1.0
